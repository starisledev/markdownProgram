{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markora",
  "version": "1.2.0",
  "identifier": "com.markora.editor",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "砚屿 — Markdown 编辑器",
        "width": 1320,
        "height": 860,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#ffffff",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../release/WebView2Loader.dll": "./WebView2Loader.dll",
      "../release/libgcc_s_seh-1.dll": "./libgcc_s_seh-1.dll",
      "../release/libwinpthread-1.dll": "./libwinpthread-1.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

{
  "name": "markora",
  "productName": "Markora",
  "version": "1.3.0",
  "description": "砚屿 — Typora 风格的所见即所得（WYSIWYG）Markdown 编辑器",
  "main": "electron/main.js",
  "author": "Markora",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis zip"
  },
  "build": {
    "appId": "com.markora.editor",
    "productName": "Markora",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "package.json",
      "LICENSE",
      "README.md"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "砚屿"
    },
    "artifactName": "Markora-${version}-windows-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3"
  }
}